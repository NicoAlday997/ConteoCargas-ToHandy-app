# Copia este archivo como `.env` (nunca se sube al repositorio) y cambia los
# valores. Los de aqui son de EJEMPLO y no sirven en produccion.
# En Render no hay `.env`: estas variables se escriben en el panel del servicio
# (ver docs/07-despliegue.md).
#
# El servidor NO arranca si falta alguna de las OBLIGATORIAS o tiene un valor
# invalido: lo dice en el log con el nombre de la variable (nunca su valor).

# ---------- OBLIGATORIAS ----------

# Cadena de conexion a Postgres. En local apunta al contenedor de
# docker-compose.yml (puerto 5433). En Render la pone la propia base.
DATABASE_URL="postgresql://handy_app:clave_de_ejemplo@localhost:5433/handy_conteo?schema=public"

# Secreto con el que se firman los tokens de sesion (JWT) de la app.
# Minimo 32 caracteres. Generalo con: openssl rand -base64 48
# Usa uno distinto en local y en produccion.
JWT_SECRET="cambia-esto-por-un-secreto-aleatorio-de-48-bytes"

# Token de integracion de la API de Handy. Solo vive en el servidor; la app
# movil nunca lo ve. Se saca del panel de Handy (ver docs/07-despliegue.md).
HANDY_API_TOKEN="token-de-ejemplo-no-real"

# URL base de la API REST v2 de Handy.
HANDY_API_BASE_URL="https://hub.handy.la/api/v2"

# Entorno: development en tu Mac, production en Render (activa la confianza en
# el proxy de Render para leer la IP real del cliente).
NODE_ENV="development"

# Zona horaria del proceso. Tiene que ser exactamente America/Mexico_City:
# la fecha operativa de las cargas se calcula en hora de Mexico.
TZ="America/Mexico_City"

# ---------- OPCIONALES ----------

# Puerto HTTP. En Render lo asigna la plataforma; en local, si no se pone, 3000.
# PORT=3000

# Sincronizacion automatica con Handy todos los dias a las 5:00 (America/Mexico_City).
# Encendida por defecto; en desarrollo local conviene apagarla con "false".
SINCRONIZACION_AUTOMATICA="false"

# Solo para `npx prisma db seed` (crea el primer supervisor). Si no se pone el
# PIN, el seed genera uno y lo imprime una sola vez.
# SEED_SUPERVISOR_NOMBRE="Supervisor Inicial"
# SEED_SUPERVISOR_PIN="1234"
