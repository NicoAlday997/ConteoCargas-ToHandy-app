// Esquema de datos — App de verificación de cargas (ver docs/02-documento-tecnico-y-diseno.md §3).
// La lógica de dominio no depende de este archivo; Prisma vive solo en la capa de infraestructura.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum RolApp {
  VENDEDOR
  CONTADOR
  SUPERVISOR
}

enum TipoCarga {
  INICIAL
  RECARGA
}

// Hoy todas las rutas operan en AUTOVENTA. La migración a PREVENTA por ruta
// introduce una cantidad esperada (suma de pedidos levantados) e invierte los
// roles de conteo (bodeguero primero, repartidor segundo). El campo se agrega
// desde ahora para no requerir una migración posterior.
enum TipoOperacion {
  AUTOVENTA
  PREVENTA
}

enum EstadoCarga {
  BORRADOR
  EN_ESPERA_CONTADOR
  BLOQUEADA_CORTE_PENDIENTE
  EN_COMPARACION
  CONFLICTOS_PENDIENTES
  EN_ESPERA_AUTORIZACION
  LISTA_PARA_ENVIAR
  ENVIADA
  ERROR_ENVIO
  ENVIO_INCIERTO
}

enum TipoSesion {
  VENDEDOR
  CONTADOR
  REFUERZO
  SUPERVISOR
}

enum EstadoSesion {
  ABIERTA
  CERRADA
}

enum UbicacionConteo {
  ALMACEN
  CALLE
}

enum ResultadoVerificacion {
  COINCIDE
  DISCREPANCIA
}

enum ResultadoRevision {
  CORRECTO
  INCORRECTO
}

enum UrgenciaAlerta {
  ALTA
  MEDIA
  BAJA
}

enum EstadoAlerta {
  PENDIENTE
  RESUELTA
  IGNORADA
}

enum Plataforma {
  ANDROID
  IOS
}

// ---------------------------------------------------------------------------
// Rutas y asignación de vendedores
// ---------------------------------------------------------------------------

model Ruta {
  id       String   @id @default(cuid())
  nombre   String
  codigo   String   @unique
  activa   Boolean  @default(true)
  creadaEn DateTime @default(now())

  asignaciones             AsignacionRutaVendedor[]
  eventosCarga             EventoCarga[]
  frecuencias              FrecuenciaProductoRuta[]
  permisosCargaSinLiquidar PermisoCargaSinLiquidar[]

  @@map("rutas")
}

// Historial de qué vendedor tiene asignada cada ruta. Al reasignar se cierra el
// registro vigente (vigenteHasta) y se abre uno nuevo, preservando el histórico.
model AsignacionRutaVendedor {
  id           String    @id @default(cuid())
  rutaId       String
  usuarioAppId String
  // La plantilla vive en la asignación, no en la ruta: si la ruta cambia de
  // catálogo con el tiempo, cada asignación histórica conserva el suyo.
  plantillaId  String?
  vigenteDesde DateTime  @default(now())
  vigenteHasta DateTime?

  ruta       Ruta            @relation(fields: [rutaId], references: [id], onDelete: Cascade)
  usuarioApp UsuarioApp      @relation(fields: [usuarioAppId], references: [id])
  plantilla  PlantillaCarga? @relation(fields: [plantillaId], references: [id])

  @@index([rutaId])
  @@index([usuarioAppId])
  @@index([plantillaId])
  @@map("asignaciones_ruta_vendedor")
}

// ---------------------------------------------------------------------------
// Usuarios de la app (autenticación propia por PIN)
// ---------------------------------------------------------------------------

model UsuarioApp {
  id                   String    @id @default(cuid())
  nombreCompleto       String
  codigoInterno        String?   @unique
  pinHash              String
  debeCambiarPin       Boolean   @default(true)
  fechaUltimoCambioPin DateTime?
  rolApp               RolApp
  // Solo se completa cuando rolApp = VENDEDOR (asignación fija por un admin).
  usuarioHandyId       Int?
  activo               Boolean   @default(true)
  // Rate limiting del RF-03: bloqueo temporal tras 5 intentos fallidos.
  intentosFallidos     Int       @default(0)
  bloqueadoHasta       DateTime?
  creadoEn             DateTime  @default(now())
  actualizadoEn        DateTime  @updatedAt

  usuarioHandy UsuarioHandy? @relation(fields: [usuarioHandyId], references: [idHandy])

  asignaciones                AsignacionRutaVendedor[]
  sesionesConteo              SesionConteo[]
  restablecimientosRecibidos  HistorialRestablecimientoPin[] @relation("RestablecimientoUsuario")
  restablecimientosRealizados HistorialRestablecimientoPin[] @relation("RestablecimientoAdmin")
  discrepanciasCapturadas     DiscrepanciaResuelta[]         @relation("DiscrepanciaCapturadaPor")
  discrepanciasConfirmadas    DiscrepanciaResuelta[]         @relation("DiscrepanciaConfirmadaPor")
  comparacionesComoVendedor   ComparacionCarga[]             @relation("ComparacionVendedor")
  comparacionesComoContador   ComparacionCarga[]             @relation("ComparacionContador")
  comparacionesComoSupervisor ComparacionCarga[]             @relation("ComparacionSupervisor")
  alertasResueltas            Alerta[]                       @relation("AlertaResueltaPor")
  dispositivosPush            DispositivoPush[]
  cargasAutorizadas           EventoCarga[]                  @relation("EventoCargaAutorizadaPor")
  factoresConfirmados         Producto[]                     @relation("FactorConfirmadoPor")
  permisosCargaOtorgados      PermisoCargaSinLiquidar[]      @relation("PermisoCargaOtorgadoPor")

  @@index([usuarioHandyId])
  @@map("usuarios_app")
}

model HistorialRestablecimientoPin {
  id              String   @id @default(cuid())
  usuarioAppId    String
  restablecidoPor String
  fecha           DateTime @default(now())

  usuarioApp UsuarioApp @relation("RestablecimientoUsuario", fields: [usuarioAppId], references: [id])
  admin      UsuarioApp @relation("RestablecimientoAdmin", fields: [restablecidoPor], references: [id])

  @@index([usuarioAppId])
  @@map("historiales_restablecimiento_pin")
}

// ---------------------------------------------------------------------------
// Cache de Handy (solo lectura desde la app, sincronizado)
// ---------------------------------------------------------------------------

// El role de Handy es un objeto {id, authority}, no un número: se guardan ambos.
model UsuarioHandy {
  idHandy              Int      @id
  nombre               String
  email                String?
  rolHandyId           Int
  rolHandyAuthority    String
  activo               Boolean  @default(true)
  ultimaSincronizacion DateTime @default(now())

  vendedores   UsuarioApp[]
  eventosCarga EventoCarga[]

  @@map("usuarios_handy")
}

/// Como se vende un producto en ruta (ver Producto.modalidadVenta).
enum ModalidadVenta {
  COMPLETO
  POR_PIEZA
}

model Producto {
  // code es la PK: es el identificador que exige la API de Handy en los payloads
  // y debe tratarse como inmutable en el cache.
  code                      String    @id
  nombre                    String
  // Siempre en centavos (Int); nunca decimal.
  precioCentavos            Int
  // Etiquetas descriptivas de unidad, sin factor de conversión.
  unidadCode                String
  unidadDescripcion         String
  familia                   String?
  activo                    Boolean   @default(true)
  lastUpdatedHandy          DateTime?
  ultimaSincronizacionLocal DateTime  @default(now())

  // Factor de empaque: en bodega se cuentan PAQUETES, Handy registra PIEZAS.
  // Handy no tiene campo para este dato (confirmado con soporte): vive aqui.
  // La sincronizacion lo PROPONE desde el nombre ("PEPSI 1.5 LT C/12" -> 12)
  // con factorConfirmado = false; un factor equivocado corrompe en silencio
  // todos los conteos del producto (el doble conteo no lo detecta porque
  // ambos usan el mismo factor), asi que no se usa hasta que un supervisor lo
  // confirma. Una vez confirmado, la sincronizacion ya no lo toca.
  //
  // Modalidad de venta: NO todo paquete se rompe. COMPLETO = el paquete es la
  // unidad de venta (dulces: Handy cobra la bolsa; el "c/70" del nombre no es
  // factor) y piezasPorPaquete se ignora. POR_PIEZA = el paquete se rompe y
  // piezasPorPaquete es el factor real. Se confirma junto con el factor: el
  // default POR_PIEZA solo existe para no romper filas previas.
  modalidadVenta          ModalidadVenta @default(POR_PIEZA)
  piezasPorPaquete        Int?
  factorConfirmado        Boolean        @default(false)
  factorConfirmadoPorId   String?
  fechaConfirmacionFactor DateTime?

  factorConfirmadoPor UsuarioApp? @relation("FactorConfirmadoPor", fields: [factorConfirmadoPorId], references: [id])

  frecuencias        FrecuenciaProductoRuta[]
  conteoItems        ConteoItem[]
  discrepancias      DiscrepanciaResuelta[]
  revisiones         RevisionSupervisor[]
  plantillaProductos PlantillaProducto[]

  @@index([factorConfirmadoPorId])
  @@map("productos")
}

// ---------------------------------------------------------------------------
// Plantillas de carga (filtran el catálogo de productos por tipo de ruta)
// ---------------------------------------------------------------------------

// Ej.: "Refrescos" (5 rutas) y "Dulces y abarrotes" (1 ruta). Evita mostrar
// los 104 productos a todos los vendedores en el grid de conteo.
model PlantillaCarga {
  id            String   @id @default(cuid())
  nombre        String
  descripcion   String?
  activa        Boolean  @default(true)
  creadaEn      DateTime @default(now())
  actualizadaEn DateTime @updatedAt

  productos    PlantillaProducto[]
  asignaciones AsignacionRutaVendedor[]
  eventosCarga EventoCarga[]

  @@map("plantillas_carga")
}

model PlantillaProducto {
  id           String @id @default(cuid())
  plantillaId  String
  productoCode String

  plantilla PlantillaCarga @relation(fields: [plantillaId], references: [id], onDelete: Cascade)
  producto  Producto       @relation(fields: [productoCode], references: [code])

  @@unique([plantillaId, productoCode])
  @@index([productoCode])
  @@map("plantillas_producto")
}

model FrecuenciaProductoRuta {
  id                      String @id @default(cuid())
  rutaId                  String
  productoCode            String
  vecesUsadoUltimos30Dias Int    @default(0)

  ruta     Ruta     @relation(fields: [rutaId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoCode], references: [code])

  @@unique([rutaId, productoCode])
  @@map("frecuencias_producto_ruta")
}

// ---------------------------------------------------------------------------
// Eventos de carga, sesiones de conteo e ítems
// ---------------------------------------------------------------------------

model EventoCarga {
  id                         String        @id @default(cuid())
  // Snapshot de la ruta: se conserva aunque el vendedor se reasigne después.
  rutaId                     String
  tipo                       TipoCarga
  // Snapshot de la plantilla vigente al momento de la carga: el historial
  // muestra el catálogo correcto aunque la asignación cambie después.
  plantillaId                String?
  // Preparación para preventa; hoy todas las cargas nacen como AUTOVENTA.
  tipoOperacion              TipoOperacion @default(AUTOVENTA)
  usuarioHandyId             Int
  estado                     EstadoCarga   @default(BORRADOR)
  // Cuando se conto: el instante real del conteo.
  fechaConteo                DateTime?
  // Dia para el que SALE el camion, distinto de cuando se conto: la carga de la
  // tarde del 23 (tras la devolucion) es la salida del 24; si el camion se
  // descompone se cuenta el 24 en la mañana para salir ese mismo dia. Siempre
  // normalizada al inicio del dia en America/Mexico_City. Una sola carga
  // INICIAL por ruta y fechaOperativa: indice unico parcial creado con SQL
  // manual en la migracion `fecha_operativa` (Prisma no soporta indices
  // parciales en el esquema).
  fechaOperativa             DateTime
  fechaBloqueoCortePendiente DateTime?
  fechaDesbloqueo            DateTime?
  fechaProgramadaEnvio       DateTime?
  fechaEnvioReal             DateTime?
  // Id de la ruta en Handy tras un envío exitoso.
  idHandy                    String?
  // Autorizacion del supervisor (EN_ESPERA_AUTORIZACION -> LISTA_PARA_ENVIAR):
  // el tercer par de ojos, la haya revisado fisicamente o no.
  autorizadaPorId            String?
  fechaAutorizacion          DateTime?
  // Carga INICIAL iniciada con la ruta anterior del vendedor sin liquidar en
  // Handy (solo posible con un PermisoCargaSinLiquidar): id de esa ruta.
  rutaHandySinLiquidarId     String?
  // Handy no respondio al verificar la liquidacion al iniciar: la carga se
  // permitio (una caida de Handy no detiene la bodega) pero queda marcada.
  liquidacionNoVerificada    Boolean       @default(false)
  creadoEn                   DateTime      @default(now())
  actualizadoEn              DateTime      @updatedAt

  ruta          Ruta            @relation(fields: [rutaId], references: [id])
  usuarioHandy  UsuarioHandy    @relation(fields: [usuarioHandyId], references: [idHandy])
  plantilla     PlantillaCarga? @relation(fields: [plantillaId], references: [id])
  autorizadaPor UsuarioApp?     @relation("EventoCargaAutorizadaPor", fields: [autorizadaPorId], references: [id])

  sesiones                SesionConteo[]
  discrepancias           DiscrepanciaResuelta[]
  comparacion             ComparacionCarga?
  permisoCargaSinLiquidar PermisoCargaSinLiquidar?

  @@index([rutaId])
  @@index([rutaId, fechaOperativa])
  @@index([usuarioHandyId])
  @@index([estado])
  @@index([plantillaId])
  @@index([autorizadaPorId])
  @@map("eventos_carga")
}

// Permiso puntual del supervisor para que una ruta inicie su carga INICIAL con
// la ruta anterior del vendedor todavia sin liquidar en Handy (a veces liquidan
// un dia despues, o dos dias juntos, pero el camion si tiene que cargar).
// Vence a las 24 horas y es de UN SOLO USO: un permiso permanente equivaldria a
// quitar la regla. Al consumirse se marca `usado` y se vincula al evento.
model PermisoCargaSinLiquidar {
  id              String   @id @default(cuid())
  rutaId          String
  otorgadoPorId   String
  motivo          String
  fechaOtorgado   DateTime @default(now())
  fechaExpiracion DateTime
  usado           Boolean  @default(false)
  // Se llena al consumirse; un evento consume a lo mucho un permiso.
  eventoCargaId   String?  @unique

  ruta        Ruta         @relation(fields: [rutaId], references: [id])
  otorgadoPor UsuarioApp   @relation("PermisoCargaOtorgadoPor", fields: [otorgadoPorId], references: [id])
  eventoCarga EventoCarga? @relation(fields: [eventoCargaId], references: [id])

  @@index([rutaId])
  @@index([usado])
  @@index([otorgadoPorId])
  @@map("permisos_carga_sin_liquidar")
}

model SesionConteo {
  id            String           @id @default(cuid())
  eventoCargaId String
  tipo          TipoSesion
  usuarioAppId  String
  dispositivoId String?
  ubicacion     UbicacionConteo?
  estado        EstadoSesion     @default(ABIERTA)
  iniciadaEn    DateTime         @default(now())
  finalizadaEn  DateTime?

  eventoCarga EventoCarga @relation(fields: [eventoCargaId], references: [id], onDelete: Cascade)
  usuarioApp  UsuarioApp  @relation(fields: [usuarioAppId], references: [id])

  items ConteoItem[]

  // Un mismo usuario no puede tener dos sesiones de conteo (abierta o cerrada)
  // sobre el mismo evento: duplicaria el conteo y arruinaria la comparacion
  // (RF-14). Respaldo a nivel de base de datos de `AbrirSesionUseCase`, que ya
  // rechaza esto en la capa de aplicacion.
  @@unique([eventoCargaId, usuarioAppId])
  @@index([usuarioAppId])
  @@map("sesiones_conteo")
}

model ConteoItem {
  id           String    @id @default(cuid())
  sesionId     String
  productoCode String
  // Lo que se cuenta en bodega: paquetes completos + piezas sueltas.
  paquetes     Int       @default(0)
  sueltas      Int       @default(0)
  // Total en PIEZAS (paquetes * piezasPorPaquete + sueltas). Es lo que se
  // compara entre conteos y lo que se envia a Handy. Lo calcula el backend;
  // nunca se recibe del cliente.
  // Int: Handy tiene fractionsInQuantityAllowed en false.
  cantidad     Int
  // Hora del DISPOSITIVO al capturar (la app puede contar sin conexion). Es el
  // reloj del cliente: solo tiene sentido junto a `recibidoEn`. La diferencia
  // entre ambas es la ventana en que el dato vivio solo en el dispositivo.
  // Nulo si el cliente no la mando.
  capturadoEn  DateTime?
  // Cuando el servidor recibio ESTE valor. Un reenvio de la misma captura no
  // la mueve. Nulo en items anteriores a este campo.
  recibidoEn   DateTime?

  sesion   SesionConteo @relation(fields: [sesionId], references: [id], onDelete: Cascade)
  producto Producto     @relation(fields: [productoCode], references: [code])

  @@unique([sesionId, productoCode])
  @@map("conteos_item")
}

// ---------------------------------------------------------------------------
// Resolución de discrepancias (captura + confirmación cruzada)
// ---------------------------------------------------------------------------

model DiscrepanciaResuelta {
  id                       String    @id @default(cuid())
  eventoCargaId            String
  productoCode             String
  cantidadVendedorOriginal Int
  cantidadContadorOriginal Int
  cantidadFinal            Int?
  capturadaPor             String?
  fechaCaptura             DateTime?
  // Regla de aplicación: confirmadaPor nunca puede ser igual a capturadaPor.
  confirmadaPor            String?
  fechaConfirmacion        DateTime?

  eventoCarga     EventoCarga @relation(fields: [eventoCargaId], references: [id], onDelete: Cascade)
  producto        Producto    @relation(fields: [productoCode], references: [code])
  usuarioCaptura  UsuarioApp? @relation("DiscrepanciaCapturadaPor", fields: [capturadaPor], references: [id])
  usuarioConfirma UsuarioApp? @relation("DiscrepanciaConfirmadaPor", fields: [confirmadaPor], references: [id])

  @@unique([eventoCargaId, productoCode])
  @@map("discrepancias_resueltas")
}

// ---------------------------------------------------------------------------
// Auditoría: comparación por evento y revisión de supervisor
// ---------------------------------------------------------------------------

model ComparacionCarga {
  id                       String                 @id @default(cuid())
  eventoCargaId            String                 @unique
  vendedorUsuarioAppId     String
  contadorUsuarioAppId     String
  totalProductos           Int
  productosConDiscrepancia Int
  evidenciaExterna         String?
  verificadoSupervisor     Boolean                @default(false)
  resultadoVerificacion    ResultadoVerificacion?
  supervisorUsuarioAppId   String?
  fechaVerificacion        DateTime?
  creadaEn                 DateTime               @default(now())

  eventoCarga EventoCarga @relation(fields: [eventoCargaId], references: [id], onDelete: Cascade)
  vendedor    UsuarioApp  @relation("ComparacionVendedor", fields: [vendedorUsuarioAppId], references: [id])
  contador    UsuarioApp  @relation("ComparacionContador", fields: [contadorUsuarioAppId], references: [id])
  supervisor  UsuarioApp? @relation("ComparacionSupervisor", fields: [supervisorUsuarioAppId], references: [id])

  revisiones RevisionSupervisor[]

  @@map("comparaciones_carga")
}

model RevisionSupervisor {
  id                     String            @id @default(cuid())
  comparacionCargaId     String
  productoCode           String
  resultado              ResultadoRevision
  cantidadRealEncontrada Int?
  fechaRevision          DateTime          @default(now())

  comparacionCarga ComparacionCarga @relation(fields: [comparacionCargaId], references: [id], onDelete: Cascade)
  producto         Producto         @relation(fields: [productoCode], references: [code])

  @@unique([comparacionCargaId, productoCode])
  @@map("revisiones_supervisor")
}

// ---------------------------------------------------------------------------
// Alertas y dispositivos push
// ---------------------------------------------------------------------------

model Alerta {
  id                 String         @id @default(cuid())
  tipo               String
  urgencia           UrgenciaAlerta
  entidadRelacionada String?
  mensaje            String
  estado             EstadoAlerta   @default(PENDIENTE)
  resueltaPor        String?
  fechaResolucion    DateTime?
  creadaEn           DateTime       @default(now())

  usuarioResuelve UsuarioApp? @relation("AlertaResueltaPor", fields: [resueltaPor], references: [id])

  @@index([estado])
  @@index([urgencia])
  @@map("alertas")
}

model DispositivoPush {
  id            String     @id @default(cuid())
  usuarioAppId  String
  fcmToken      String     @unique
  plataforma    Plataforma
  creadoEn      DateTime   @default(now())
  actualizadoEn DateTime   @updatedAt

  usuarioApp UsuarioApp @relation(fields: [usuarioAppId], references: [id], onDelete: Cascade)

  @@index([usuarioAppId])
  @@map("dispositivos_push")
}
